// See https://containers.dev/implementors/json_reference/ for configuration reference
{
  "name": "remix-v3-demo",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/remix-v3-demo",
  "forwardPorts": [3000, 4000, 54321, 54322, 54323],
  "portsAttributes": {
    "3000": { "label": "frontend-tanstack" },
    "4000": { "label": "frontend-remix" },
    "54321": { "label": "supabase-api" },
    "54322": { "label": "supabase-db" },
    "54323": { "label": "supabase-studio" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "node",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "GPG_AGENT_INFO": "",
    "BROWSER": "",
    "VSCODE_IPC_HOOK_CLI": null,
    "VSCODE_GIT_IPC_HANDLE": null,
    "GIT_ASKPASS": null,
    "VSCODE_GIT_ASKPASS_MAIN": null,
    "VSCODE_GIT_ASKPASS_NODE": null,
    "VSCODE_GIT_ASKPASS_EXTRA_ARGS": null,
    "REMOTE_CONTAINERS_IPC": null,
    "REMOTE_CONTAINERS_SOCKETS": null,
    "REMOTE_CONTAINERS_DISPLAY_SOCK": null,
    "WAYLAND_DISPLAY": null
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "./gh": {},
    "./claude-code": {},
    "./playwright": {},
    "./pnpm": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"],
      "settings": {
        "dev.containers.dockerCredentialHelper": false,
        "dev.containers.copyGitConfig": false
      }
    }
  },
  "mounts": [
    {
      "type": "volume",
      "source": "${devcontainerId}-tmp",
      "target": "/tmp"
    },
    {
      "type": "volume",
      "source": "${devcontainerId}-supabase",
      "target": "/home/node/.supabase"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/dev/memnos",
      "target": "/home/node/dev/memnos"
    }
  ]
}
